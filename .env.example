# Required: Hugging Face token for diarization model access
HF_TOKEN=YOUR_HF_TOKEN_HERE

# Optional variables below are pre-set to their defaults. Uncomment and edit to override.

# Optional: Inference device (default: cuda)
# DEVICE=cuda

# Optional: Model compute precision (default: float16)
# COMPUTE_TYPE=float16

# Optional: Transcription batch size (default: 16)
# BATCH_SIZE=16

# Optional: Default transcription model (default: medium.en)
# Choices: tiny.en, base.en, small.en, medium.en, large-v2, large-v3, turbo
# DEFAULT_MODEL=medium.en

# Optional: Log level for noisy third-party loggers (default: ERROR)
# THIRD_PARTY_LOG_LEVEL=ERROR

# Optional: Whether to filter noisy third-party warnings (default: true)
# WARNINGS_ENABLED=true

# Optional: Action applied to filtered warnings (default: ignore)
# Choices: default, error, ignore, always, module, once
# WARNINGS_ACTION=ignore

# Optional: Top-level directory application log files are written to (default: logs)
# LOG_DIR=logs

# Optional: Log level for the application's own logger (default: INFO)
# Choices: DEBUG, INFO, WARNING, ERROR, CRITICAL
# LOG_LEVEL=INFO

# Optional: Number of most-recent run log files to keep in logs/ (default: 10)
# LOG_RETENTION_COUNT=10
