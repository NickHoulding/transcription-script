# Environment variable configuration for the transcription pipeline. Everything under the optional section can be left blank to fall back to their built-in default.

# -------------------------------------------------------------------------
# Required variables
# -------------------------------------------------------------------------

# Hugging Face token for diarization model access
HF_TOKEN=YOUR_HF_TOKEN_HERE

# -------------------------------------------------------------------------
# Optional variables
# -------------------------------------------------------------------------

# Inference device. Leave blank to auto-detect (cuda if available, else cpu).
DEVICE=

# Model compute precision. Leave blank to auto-detect based on device.
COMPUTE_TYPE=

# Transcription batch size.
BATCH_SIZE=

# Default transcription model. 
# Choices: tiny.en, base.en, small.en, medium.en, large-v2, large-v3, turbo
DEFAULT_MODEL=

# Top-level directory models are downloaded/cached into.
MODEL_DIR=

# Log level for noisy third-party loggers.
# Choices: DEBUG, INFO, WARNING, ERROR, CRITICAL
THIRD_PARTY_LOG_LEVEL=

# Whether to filter noisy third-party warnings.
# Choices: true, false
WARNINGS_ENABLED=

# Action applied to filtered warnings.
# Choices: default, error, ignore, always, module, once
WARNINGS_ACTION=

# Top-level directory application log files are written to.
LOG_DIR=

# Log level for the application's own logger.
# Choices: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=

# Number of most-recent run log files to keep in logs/.
LOG_RETENTION_COUNT=
